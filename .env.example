# =============================================================================
# HK Event — Variables d'environnement frontend (Vite)
# =============================================================================
#
# Copiez ce fichier si besoin :
#   cp .env.example .env.local
#
# Environnements automatiques :
#   npm run dev   → charge .env.development (+ .env.local)
#   npm run build → charge .env.production (+ .env.local)
#
# VITE_API_URL        = URL API avec /api
# VITE_API_BASE_URL   = URL serveur sans /api (images, uploads)
# =============================================================================

# --- Local (développement) ---
# VITE_API_URL=http://localhost:5000/api
# VITE_API_BASE_URL=http://localhost:5000

# --- Production ---
# VITE_API_URL=https://api.hkeventscd.com/api
# VITE_API_BASE_URL=https://api.hkeventscd.com
