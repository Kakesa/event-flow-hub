server {
  listen ${PORT};
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  location = /manifest.webmanifest {
    add_header Cache-Control "public, max-age=86400";
    default_type application/manifest+json;
  }

  # Ne pas mettre try_files =404 ici : avec le fallback SPA sur /index.html,
  # cela peut provoquer des 500 si le fichier est absent ou mal déployé.
  location = /index.html {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
  }

  location = /sw.js {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
  }

  location ~* ^/workbox-.*\.js$ {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location /images/ {
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?)$ {
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
