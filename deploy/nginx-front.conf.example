# Nginx — Frontend SPA (www.hkeventscd.com)
# Copier vers /etc/nginx/sites-available/www.hkeventscd.com puis :
#   sudo ln -sf /etc/nginx/sites-available/www.hkeventscd.com /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Fichiers statiques : /var/www/html/react/event-flow-hub  (contenu de npm run build → dist/)

server {
    listen 80;
    server_name hkeventscd.com www.hkeventscd.com;
    return 301 https://www.hkeventscd.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.hkeventscd.com;

    ssl_certificate /etc/letsencrypt/live/www.hkeventscd.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.hkeventscd.com/privkey.pem;

    root /var/www/html/react/event-flow-hub;
    index index.html;

    # Logs utiles en cas de 500
    error_log /var/log/nginx/hkevents-front.error.log warn;
    access_log /var/log/nginx/hkevents-front.access.log;

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location = /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location ~* ^/workbox-.*\.js$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location = /manifest.webmanifest {
        add_header Cache-Control "public, max-age=86400";
        default_type application/manifest+json;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location /images/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA — toutes les routes React
    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 443 ssl http2;
    server_name hkeventscd.com;
    ssl_certificate /etc/letsencrypt/live/www.hkeventscd.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.hkeventscd.com/privkey.pem;
    return 301 https://www.hkeventscd.com$request_uri;
}
